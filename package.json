{
  "name": "my-workflow-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fix:auth": "psql postgresql://postgres:postgres@127.0.0.1:56322/postgres -f supabase/scripts/fix-auth-login.sql",
    "test:db": "supabase test db && npm run fix:auth",
    "test:db:reset": "supabase db reset && supabase test db && npm run fix:auth",
    "demo:schema-rebuild": "psql \"%DEMO_DATABASE_URL%\" -f supabase/demo-schema-rebuild.sql",
    "demo:wipe": "psql \"%DEMO_DATABASE_URL%\" -f supabase/demo-wipe.sql",
    "demo:seed": "psql \"%DEMO_DATABASE_URL%\" -f supabase/demo-seed.sql",
    "demo:reset": "npm run demo:wipe && npm run demo:seed"
  },
  "dependencies": {
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "csv-parse": "^6.1.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.37",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5"
  }
}
